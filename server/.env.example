# Copy this file to .env (in this server/ folder) and fill it in. Never commit .env.

# --- Login -------------------------------------------------------------------------------------
# The password the phone sends with every sync (Sync -> Sync password in the app). Required.
# The server refuses to start without one, or with one under 16 characters or with fewer than
# 8 different characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
SYNC_PASSWORD=change-me-to-a-long-random-string

# --- Server ------------------------------------------------------------------------------------
# The server only ever listens on 127.0.0.1 (this computer), so it's reachable from outside only
# through the Cloudflare Tunnel running here. Point the tunnel's hostname at http://127.0.0.1:PORT.
PORT=8766
# Addresses allowed to tell the server the visitor's real address (X-Forwarded-For), which the
# wrong-password limit counts by. The default, this computer, fits cloudflared running here.
# Never "*": that would let any visitor claim any address.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Largest sync body accepted, in bytes (the whole log as JSON). 10 MB is far more than the
# phone's own storage holds.
# MAX_BODY_BYTES=10485760

# --- Data --------------------------------------------------------------------------------------
# Where snapshots and the per-roll JSON files go. Relative paths are relative to this server/
# folder; data/ there is git-ignored. An absolute path outside the repo works too,
# e.g. D:/FrameLog/sync-data
DATA_DIR=data
# Folder holding index.html, sw.js, manifest.json and the icons. Default: the repo root (../).
# STATIC_DIR=

# --- S3 backup (optional) ----------------------------------------------------------------------
# Leave S3_BUCKET empty to keep S3 off; everything else works without it. To turn it on, fill in
# the bucket and its region, restart, and run `uv run python -m framelog_sync.cli s3-verify`.
S3_BUCKET=
# The bucket's region, e.g. us-east-1 (AWS_REGION is used if this is empty).
S3_REGION=
# Folder inside the bucket. Empty = the bucket's root.
S3_PREFIX=framelog
# Credentials: either the two keys here...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ...or leave them out and use a profile from %USERPROFILE%\.aws\credentials (boto3's usual
# credentials chain). AWS_PROFILE picks a named profile; without it, [default] is used.
# AWS_PROFILE=framelog-backup
